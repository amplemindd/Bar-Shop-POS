# Local MySQL connection (create the database first using database/bar_shop_pos.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=bar_shop_pos

# Local application security
PORT=5000
JWT_SECRET=replace_this_with_a_long_random_secret_before_running
APP_TZ=Asia/Kolkata
DB_TZ=+05:30
CLIENT_ORIGIN=http://localhost:3000

# First administrator account created automatically on first database setup
ADMIN_EMAIL=admin@barshop.local
ADMIN_PASSWORD=ChangeMe123!
